{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "bash software/one_website/vercel-build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/learn/refrigerator",
      "destination": "/learn/refrigerator/index.html"
    },
    {
      "source": "/learn/refrigerator/",
      "destination": "/learn/refrigerator/index.html"
    },
    {
      "source": "/learn/distributed-information",
      "destination": "/learn/distributed-information/index.html"
    },
    {
      "source": "/learn/distributed-information/",
      "destination": "/learn/distributed-information/index.html"
    },
    {
      "source": "/research",
      "destination": "/research/index.html"
    },
    {
      "source": "/research/",
      "destination": "/research/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), display-capture=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; connect-src 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
