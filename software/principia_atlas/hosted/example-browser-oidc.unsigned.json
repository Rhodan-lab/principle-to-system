{
  "contract": "principia-atlas-browser-oidc/0.1",
  "product": "Principia & Atlas",
  "issuer": "https://identity.example.test",
  "public_origin": "https://learn.example.test",
  "authorization_endpoint": "https://identity.example.test/authorize",
  "token_endpoint": "https://identity.example.test/token",
  "client_id": "principia-atlas-browser",
  "client_auth_method": "client_secret_post",
  "scopes": [
    "openid",
    "email"
  ],
  "login_path": "/auth/login",
  "callback_path": "/auth/callback",
  "default_return_to": "/",
  "flow_ttl_seconds": 300,
  "token_timeout_ms": 3000,
  "token_max_bytes": 65536,
  "cookie": {
    "name": "__Host-pa_oidc_flow",
    "secure": true,
    "same_site": "Lax"
  }
}
