{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rhodan-lab/principle-to-system/contracts/principia-atlas/0.1/bridge-manifest.schema.json",
  "title": "Principia–Atlas Bridge Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "mode",
    "live",
    "principia",
    "atlas",
    "status_policy",
    "export"
  ],
  "properties": {
    "contract": {
      "const": "principia-atlas-bridge/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^bridge:[a-z0-9][a-z0-9:-]*$"
    },
    "mode": {
      "const": "compatibility-fixture"
    },
    "live": {
      "const": false
    },
    "principia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "artifact_id",
        "path",
        "artifact_revision",
        "pedagogical_status_field",
        "pedagogical_status",
        "release_status"
      ],
      "properties": {
        "repository": {
          "const": "Rhodan-lab/principle-to-system"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^principia:(system-dossier|failure-pattern|investigation|design-challenge):[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(system-dossiers|failure-atlas|investigations|design-challenges)/[a-z0-9][a-z0-9-]*\\.md$"
        },
        "artifact_revision": {
          "type": "integer",
          "minimum": 1
        },
        "pedagogical_status_field": {
          "const": "status"
        },
        "pedagogical_status": {
          "enum": ["draft", "reviewed", "complete", "blocked"]
        },
        "release_status": {
          "enum": ["draft", "candidate", "released", "withdrawn"]
        }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "content_contract", "dependencies"],
      "properties": {
        "repository": {
          "const": "Rhodan-lab/Atlas"
        },
        "content_contract": {
          "const": "atlas-content/0.1"
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "entity_type",
              "role",
              "use",
              "change_policy"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(src|evidence|claim|concept|model|question|synthesis):[a-z0-9][a-z0-9:-]*$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "entity_type": {
                "enum": [
                  "source",
                  "evidence",
                  "claim",
                  "concept",
                  "model",
                  "question",
                  "synthesis"
                ]
              },
              "role": {
                "enum": ["load-bearing", "supporting", "context"]
              },
              "use": {
                "enum": [
                  "definition",
                  "evidence",
                  "claim-boundary",
                  "model",
                  "model-boundary",
                  "source-context",
                  "synthesis-context"
                ]
              },
              "change_policy": {
                "enum": ["inspect", "revalidate", "block-release"]
              }
            }
          }
        }
      }
    },
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_status_inheritance",
        "pedagogical_status_inheritance",
        "release_status_inheritance",
        "atlas_status_authority",
        "principia_status_authority"
      ],
      "properties": {
        "knowledge_status_inheritance": {
          "const": "prohibited"
        },
        "pedagogical_status_inheritance": {
          "const": "prohibited"
        },
        "release_status_inheritance": {
          "const": "prohibited"
        },
        "atlas_status_authority": {
          "const": "Atlas"
        },
        "principia_status_authority": {
          "const": "Principia"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": {
          "const": "principia-artifact"
        },
        "role": {
          "enum": ["load-bearing", "supporting", "context"]
        }
      }
    }
  }
}
